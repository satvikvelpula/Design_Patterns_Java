<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox fx:id="root" spacing="14.0" xmlns="http://javafx.com/javafx/22"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="TemperatureViewController">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0"/>
    </padding>

    <Label fx:id="titleLabel" text="%app.title" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <GridPane hgap="10.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="120.0"/>
            <ColumnConstraints hgrow="ALWAYS" minWidth="220.0"/>
        </columnConstraints>

        <Label fx:id="languageLabel" text="%label.language" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="languageBox" prefWidth="280.0" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label fx:id="valueLabel" text="%label.value" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="inputField" promptText="%prompt.value" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label fx:id="fromLabel" text="%label.from" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <ComboBox fx:id="fromUnitBox" prefWidth="280.0" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label fx:id="toLabel" text="%label.to" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <ComboBox fx:id="toUnitBox" prefWidth="280.0" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label fx:id="resultLabel" text="%result.placeholder" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
    </GridPane>

    <HBox spacing="10.0">
        <Button fx:id="convertButton" text="%button.convert" onAction="#onConvert"/>
        <Button fx:id="saveButton" text="%button.save" onAction="#onSave"/>
        <Button fx:id="refreshButton" text="%button.refresh" onAction="#onRefresh"/>
    </HBox>

    <Label fx:id="historyLabel" text="%label.history"/>
    <TableView fx:id="historyTable" prefHeight="240.0" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="idColumn" text="%col.id" prefWidth="60.0"/>
            <TableColumn fx:id="valueColumn" text="%col.value" prefWidth="100.0"/>
            <TableColumn fx:id="unitColumn" text="%col.unit" prefWidth="80.0"/>
            <TableColumn fx:id="timeColumn" text="%col.time" prefWidth="200.0"/>
        </columns>
    </TableView>
</VBox>
